# Rust
/target
**/target
# NOTE: Cargo.lock is tracked deliberately (binary workspace)

# LaTeX build artifacts (PDF is tracked deliberately)
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/sections/*.aux

# Editors / local
.vscode/
.idea/
*.swp

# Working documents. A review or plan is a chronology — what was found, when,
# and in which order it was fixed — and the tree is a snapshot of what the code
# IS. Git carries the chronology; these stay on disk and out of it.
/REVIEW-*.md
/PLAN-*.md
/REPORT*.md

# Python bytecode
__pycache__/
.venv*/

# Persona-layer output. A queue is a working document, and the tree carries no
# chronology (`crates/swarm/personas/` holds the prompts, the cards and the
# schema; nothing it produces belongs here).
/PERSONA-*.md

# Node caches at the root (a vitest run writes one); the client's own
# node_modules is ignored under ui/.
node_modules/
