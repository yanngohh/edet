<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged into the app's manifest by AGP. It is here rather than in
  `app/src/main/AndroidManifest.xml` because that file is regenerated by
  `tauri android init` and is not tracked: a `<service>` written there would be
  one regeneration away from gone, with every gate still green.

  `specialUse` rather than `dataSync`: `dataSync` is cut off after six hours in
  any twenty-four and reset only when the app returns to the foreground, which
  is exactly the till this mode is for — a device left running for days. This
  APK is sideloaded over USB, so no store reads the subtype property; it is
  written for the operator who reads the manifest.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- The service's OWN notification is exempt; this is for the one that
         says a purchase was signed while the member was not looking. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="org.edet.client.background.AcceptanceService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a mutual-credit wallet's acceptance rule polling its node and co-signing purchases while the app is in the background. The signing key never leaves the device and the service itself cannot sign." />
        </service>
    </application>
</manifest>
