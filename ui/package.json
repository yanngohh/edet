{
  "name": "edet-ui",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "edet consumer client: wallet, contracts, community, support, governance over the embedded node (Tauri IPC) or a dev cluster (HTTP)",
  "scripts": {
    "dev": "vite",
    "build": "npm run prepare-themes && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "node scripts/prepare-themes.mjs",
    "prepare-themes": "node scripts/prepare-themes.mjs",
    "prepare-themes:force": "node scripts/prepare-themes.mjs --force",
    "locales:fingerprint": "node scripts/locale-fingerprint.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "@scure/bip39": "^1.6.0",
    "@smui/button": "^7.0.0",
    "@smui/checkbox": "^7.0.0",
    "@smui/circular-progress": "^7.0.0",
    "@smui/common": "^7.0.0",
    "@smui/dialog": "^7.0.0",
    "@smui/drawer": "^7.0.0",
    "@smui/fab": "^7.0.0",
    "@smui/form-field": "^7.0.0",
    "@smui/icon-button": "^7.0.0",
    "@smui/linear-progress": "^7.0.0",
    "@smui/list": "^7.0.0",
    "@smui/slider": "^7.0.0",
    "@smui/snackbar": "^7.0.0",
    "@smui/textfield": "^7.0.0",
    "@smui/top-app-bar": "^7.0.0",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@types/qrcode": "^1.5.6",
    "html5-qrcode": "^2.3.8",
    "localforage": "^1.10.0",
    "material-icons": "^1.13.14",
    "qrcode": "^1.5.4",
    "shepherd.js": "^14.3.0",
    "svelte-i18n": "^4.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@testing-library/svelte": "^4.2.3",
    "@tsconfig/svelte": "^5.0.0",
    "@types/node": "^20.14.10",
    "jsdom": "^25.0.0",
    "smui-theme": "^7.0.0",
    "svelte": "^4.2.19",
    "svelte-check": "^4.0.4",
    "tslib": "^2.4.1",
    "typescript": "^5.5.4",
